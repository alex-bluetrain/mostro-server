# Copy to .env and fill in. Ordered like a real working .env.
#
# Optional vars must be ABSENT, not empty: an empty value fails zod validation
# (src/mastra/config/app.config.ts) and aborts the boot. Uncomment only the
# ones you fill in.

# --- LLM (required) ---
# All agents run through OpenRouter (model configured in code).
OPENROUTER_API_KEY=

# --- Telegram bot (required) ---
# Username without the leading @. Webhook secret is any random string you make
# up; Telegram echoes it back so the server can verify webhook authenticity.
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# --- Discord bot (optional) ---
# Secondary channel: Discord doesn't onboard anyone. A user already registered
# through Telegram links their Discord id from the chat (see docs/identity.md).
# The three go together or none does: the adapter throws in its constructor if
# any is missing, so without all three the channel isn't registered at all.
# From the Discord Developer Portal: Bot > Token, General Information >
# Application ID and Public Key.
# DISCORD_BOT_TOKEN=
# DISCORD_APPLICATION_ID=
# DISCORD_PUBLIC_KEY=

# --- Ngrok tunnel (optional) ---
# Exposes the local server for Telegram webhooks. Opens only when NGROK_AUTHTOKEN
# and NGROK_FORWARD_ADDR are both set. You still have to register the webhook URL
# with Telegram (setWebhook); without one the bot long-polls and needs no tunnel.
# NGROK_AUTHTOKEN=
# NGROK_DOMAIN=
# Where the tunnel points: this server. In Docker it's mostro-server:4111 (the
# compose hostname); in local dev it's localhost:4111.
# NGROK_FORWARD_ADDR=
# Not a var of this app: read by the Mastra framework itself (not app.config.ts).
# Studio's default "instance URL" otherwise stays hardcoded to localhost:4111,
# which breaks Studio when opened from the ngrok domain. This makes it use
# window.location.origin instead, so it works from any origin (LAN, ngrok, etc).
MASTRA_AUTO_DETECT_URL=true

# --- MongoDB (required) ---
# Holds workflow runs, memory, identity, subscribers and classifier rules.
# A fresh environment needs seeding after boot:
#   1. Classifier rules (one per domain), or the poll workflows fail with
#      no active pointer: pnpm seed:classifier -- --domain <d> --file <json> ...
#      (templates in docs/classifier-rules/, see docs/inbox-pipeline.md). Can be
#      automated with the CLASSIFIER_RULES_* vars below.
#   2. Notification subscribers: subscribe via the Telegram bot, otherwise
#      notify-users steps complete with notifiedCount: 0.
MONGODB_URI=
MONGODB_DB_NAME=

# --- Studio admin access (optional) ---
# Enables SimpleAuth for Mastra Studio alongside Google auth. Meant for prod:
# lets a local Studio point at prod with an admin token. Must be >= 32 chars.
# STUDIO_API_KEY=

# --- Google auth (optional) ---
# GOOGLE_CLIENT_ID alone enables Bearer id_token auth (Android): the client
# sends Google's id_token and mostro verifies it against JWKS. Opt-in like
# STUDIO_API_KEY.
# GOOGLE_CLIENT_ID=
#
# Web session (docs/web-session.md): set ALL of these to enable the redirect
# login + 30-day HttpOnly session cookie for the web app.
# GOOGLE_CLIENT_SECRET=
# GOOGLE_COOKIE_PASSWORD=        # >= 32 chars, signs the session cookie
# WEB_AUTH_URL=https://<PROD_DOMAIN>/api   # server as the browser sees it (Pages proxy)
# WEB_APP_URL=https://<PROD_DOMAIN>        # where the browser lands after login

# --- Gmail mailer (required) ---
# Its own OAuth client, unrelated to the GOOGLE_CLIENT_ID used for login. Authorize it
# once with Mostro's own Gmail account. The app must be published to production:
# in Testing mode the refresh token dies after 7 days.
# Get the refresh token with: pnpm run gmail:auth
GMAIL_MAILER_CLIENT_ID=
GMAIL_MAILER_CLIENT_SECRET=
GMAIL_MAILER_REFRESH_TOKEN=
GMAIL_MAILER_SENDER=

# --- Provider addresses (required) ---
# Each one plays a double role per domain:
#   - Outbound: destination of the request emails the workflows send.
#   - Inbound: filter for the mailbox poll (from:<address> in the Gmail query
#     built from the inbox config's queryDescription).
# For local testing, plus-aliases of your own account work well
# (e.g. you+meds@gmail.com).
DIAPERS_EMAIL_TO=
MEDS_EMAIL_TO=
REFUNDS_EMAIL_TO=

# --- Case details (required) ---
# Shared across every flow (diapers, meds, refunds): who receives the delivery and
# who signs the request before the provider. This is NOT the user who triggered the
# order from Telegram — the provider needs a stable contact, not whoever asked.
PATIENT_NAME=
DELIVERY_ADDRESS=
REQUESTER_NAME=
REQUESTER_PHONE=

# --- Classifier rules bootstrap (optional) ---
# Minified rules JSON per domain. Seed-if-missing: on boot, a domain WITHOUT an
# active pointer gets this published as its first snapshot; a domain that already
# has one is never touched (the DB stays the owner of the rules). Meant for prod
# via Infisical, so a fresh database can't leave the polls failing every cycle.
# Minify with:
#   node -e "console.log(JSON.stringify(JSON.parse(require('fs').readFileSync('<path>.json','utf8'))))"
# CLASSIFIER_RULES_DIAPERS=
# CLASSIFIER_RULES_MEDS=
# CLASSIFIER_RULES_REFUNDS=

# --- Axiom logs (optional) ---
# Both or neither: with them set, PinoLogger also ships every log to the Axiom
# dataset (stdout keeps working); with either missing the boot warns and logs
# stay local only. Use an API token scoped to ingest on that single dataset.
# AXIOM_TOKEN=
# AXIOM_DATASET=

# --- Admin seed (optional, but recommended) ---
# Without ADMIN_EMAIL nobody is authorized (see docs/identity.md).
# ADMIN_TELEGRAM_ID=
# ADMIN_NAME=
# ADMIN_EMAIL=

# --- Server (optional) ---
# PORT=4111
# DuckDB file for local analytics/storage. Defaults to mastra.duckdb.
# DUCKDB_PATH=mastra.duckdb
# Extra CORS origins for local dev, comma-separated. The ngrok domain is already
# allowed; this adds e.g. the Expo web dev server (http://localhost:8081) without
# touching code. Empty in prod.
# DEV_CORS_ORIGINS=
