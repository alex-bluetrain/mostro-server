{
  "name": "mostro-server",
  "version": "1.14.0",
  "description": "A multi-agent Telegram bot for managing recurring family orders — diapers, medications, and refunds — built with Mastra.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Alex Verstraeten <averstraeten@gmail.com>",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gmail:auth": "node --env-file=.env scripts/gmail-authorize.mjs",
    "seed:classifier": "node --env-file=.env --import tsx scripts/seed-classifier.ts",
    "seed:runs": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/seed-workflow-runs.ts",
    "generate:openui-prompt": "node --import tsx scripts/generate-openui-prompt.ts"
  },
  "dependencies": {
    "@ag-ui/core": "^0.0.58",
    "@ag-ui/mastra": "^1.1.2",
    "@axiomhq/pino": "^2.0.0",
    "@chat-adapter/discord": "4.38.0",
    "@chat-adapter/telegram": "4.38.0",
    "@googleapis/gmail": "^17.0.0",
    "@mastra/ai-sdk": "^1.10.0",
    "@mastra/auth": "^1.1.2",
    "@mastra/auth-google": "^0.1.2",
    "@mastra/core": "^1.63.0",
    "@mastra/duckdb": "^1.6.3",
    "@mastra/editor": "^0.14.1",
    "@mastra/evals": "^1.9.0",
    "@mastra/libsql": "^1.22.0",
    "@mastra/loggers": "^1.3.0",
    "@mastra/memory": "^1.28.0",
    "@mastra/mongodb": "^1.18.2",
    "@mastra/observability": "^1.17.3",
    "@ngrok/ngrok": "^1.7.0",
    "ajv": "^8.20.0",
    "cheerio": "^1.2.0",
    "email-reply-parser": "^2.3.9",
    "mongodb": "^7.6.0",
    "mongoose": "^8.24.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@openuidev/react-lang": "^0.3.0",
    "@openuidev/react-ui": "^0.16.2",
    "@types/email-reply-parser": "^1.4.2",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.4.0",
    "mailparser": "^3.9.17",
    "mastra": "^1.27.0",
    "react": "^19.2.8",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
